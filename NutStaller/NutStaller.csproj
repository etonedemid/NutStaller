<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- no libicu needed at runtime; one less thing that differs between distros -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyTitle>NutStaller</AssemblyTitle>
    <Product>NutStaller - reNut Launcher</Product>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\ANDYB.TTF" />
    <AvaloniaResource Include="Assets\bg.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
  </ItemGroup>

</Project>
